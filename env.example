# ─────────────────────────────────────────────────────────────────
# PLUM OPS — Environment Variables Template
# Copy this file to .env and fill in your actual keys.
# Get free Gemini API keys at: https://aistudio.google.com
# ─────────────────────────────────────────────────────────────────

# Primary Gemini API Key
REACT_APP_GEMINI_KEY_1=YOUR_GEMINI_API_KEY_1_HERE

# Secondary Gemini API Key (fallback)
REACT_APP_GEMINI_KEY_2=YOUR_GEMINI_API_KEY_2_HERE

# Tertiary Gemini API Key (fallback)
REACT_APP_GEMINI_KEY_3=YOUR_GEMINI_API_KEY_3_HERE
